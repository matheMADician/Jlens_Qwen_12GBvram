{
    "model": {
        "id": "Qwen/Qwen2.5-Omni-7B",
        "adapter": "Qwen/Qwen2.5-Omni-7B",
        "load_in_4bit": false
    },
    "fitting": {
        "root": "data",
        "jsonl_path": "data/assembled/train_upscale_1/prompts.jsonl",
        "max_seq_len": 3000,
        "dim_batch": 32,
        "checkpoint_interval": 5,
        "checkpoint_root": "output/checkpoints",
        "experiment": {
            "seed": 42,
            "mode": null,
            "max_prompts": 1000000,
            "save_prompt_count": [1, 5, 10, 50, 100, 500],
            "random_projection": true,
            "projection_dim_seed": [[128, 42]],
            "save_projected_features": true,
            "save_dataset_lenses": true,
            "save_milestone_lenses": true,
            "tsne_perplexity": 30.0,
            "is_test": false
        }
    },
    "inference": {
        "max_length": 300,
        "top_k": 5,
        "jsonl_path": "data/assembled/test_SAKURA_AnimalQA/prompts.jsonl",
        "output_root": "output/inference"
    },
    "experiment": {
        "matrix_analysis": {
            "SVD_top_k": 8,
            "output_root": "output/experiments"
        },
        "pass_k_AUC": {
            "k_values": [1, 2, 4, 8, 16, 32, 64, 128, 256],
            "output_root": "output/pass_k_AUC"
        }
    }
}